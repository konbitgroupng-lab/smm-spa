# Copy to .env.local and fill in. .env* files are git-ignored (except this one).

# ---------------------------------------------------------------------------
# FRONTEND - safe to expose. Vite bundles every VITE_* variable into the browser.
# ---------------------------------------------------------------------------
# Supabase project URL (local dev: http://127.0.0.1:54321).
VITE_SUPABASE_URL=""
# Supabase anon / publishable key. Row Level Security limits what it can do.
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# SERVER ONLY - never prefix with VITE_, never import into src/, never commit.
# In production these live in Supabase function secrets (`supabase secrets set`),
# not in this file and not in any admin dashboard field.
# ---------------------------------------------------------------------------
# Used only by local scripts (scripts/seed-demo-users.mjs).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional. Password for the local demo staff logins; generated when empty.
DEMO_USER_PASSWORD=""

# Phase 3 (payments) - listed here so the names are agreed; not used yet.
# PAYSTACK_SECRET_KEY=""   # sk_test_... in development, sk_live_... in production
