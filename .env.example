# Copy to .env.local and fill in. .env* files are git-ignored (except this one).

# ---------------------------------------------------------------------------
# FRONTEND - safe to expose. Vite bundles every VITE_* variable into the browser.
# ---------------------------------------------------------------------------
# Supabase project URL (local dev: http://127.0.0.1:54321).
VITE_SUPABASE_URL=""
# Supabase anon / publishable key. Row Level Security limits what it can do.
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# SERVER ONLY - never prefix with VITE_, never import into src/, never commit.
# In production these live in Supabase function secrets (`supabase secrets set`),
# not in this file and not in any admin dashboard field.
# ---------------------------------------------------------------------------
# Used only by local scripts (scripts/seed-demo-users.mjs).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional. Password for the local demo staff logins; generated when empty.
DEMO_USER_PASSWORD=""

# Edge Function secrets for the `booking` function. Set them with
# `npx supabase secrets set NAME=value` (hosted) or in supabase/functions/.env (local).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
# ALLOWED_ORIGINS=""       # comma-separated site origins, e.g. https://example.com,http://localhost:3000
# RATE_LIMIT_SALT=""       # any long random string

# Frontend, optional: "true" serves the booking prototype (?view=booking-prototype)
# outside development builds.
# VITE_ENABLE_BOOKING_PROTOTYPE=""

# Function setting: which payment provider the Edge Functions use.
#   mock      simulated payments - no real money (development and demos)
#   paystack  real Paystack (needs PAYSTACK_SECRET_KEY below)
# There is no default; functions refuse to start without it.
# PAYMENT_PROVIDER="mock"
# Optional, mock only: the site page that plays the hosted checkout
# (default: the site the guest returns to).
# DEMO_CHECKOUT_URL=""

# Function secret for `payments` and `paystack-webhook` with PAYMENT_PROVIDER=paystack. Set with `supabase secrets set`.
# It also signs Paystack's webhooks. Never put it in a VITE_ variable, the database
# or an admin screen. The automated tests use a simulated Paystack and need no key.
# PAYSTACK_SECRET_KEY=""   # sk_test_... in development, sk_live_... in production
